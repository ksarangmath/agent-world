{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-world",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "joinagentworld.com", "custom_domain": true }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f6cfce74f6a1442a979e104ad4741bb6",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  "secrets": {
    "required": [
      "APP_URL",
      "VITE_SUPABASE_URL",
      "VITE_SUPABASE_PUBLISHABLE_KEY",
      "OMNARA_TOKEN",
      "OMNARA_ORG_ID",
      "OMNARA_PROJECT_ID",
      "OMNARA_WEBHOOK_SECRET",
      "OMNARA_WEBHOOK_SECRET_ID",
      "OMNARA_WORLD_PROFILE_ID",
      "OMNARA_BUILDER_PROFILE_ID",
      "EXA_API_KEY",
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "cache": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
