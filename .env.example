# Copy to .env for local development. Production values are Cloudflare secrets.

# Runtime
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase direct connection string (IPv6), ending in ?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt.
# Used for migrations and as the Hyperdrive origin.
DATABASE_URL=
OMNARA_TOKEN=
OMNARA_ORG_ID=
OMNARA_PROJECT_ID=
# The signing key for Omnara's webhooks
OMNARA_WEBHOOK_SECRET=
# Profiles agents launch under; local development uses the -test profiles
OMNARA_WORLD_PROFILE_ID=
OMNARA_BUILDER_PROFILE_ID=
EXA_API_KEY=
OPENAI_API_KEY=

# Tooling for migrations and deploys; the running app never reads these
# pnpm webhooks subscribes both profiles to APP_URL's webhook, signed with the
# Omnara secret OMNARA_WEBHOOK_SECRET_ID, which holds OMNARA_WEBHOOK_SECRET
APP_URL=
OMNARA_WEBHOOK_SECRET_ID=
SUPABASE_ACCESS_TOKEN=
# LinkedIn sign-in app; local Supabase reads these via env() in supabase/config.toml
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
