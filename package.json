{
  "name": "agent-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "wrangler types worker/worker-configuration.d.ts --check && tsc -p . && tsc -p web && tsc -p worker",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run --exclude '**/*.db.test.ts'",
    "test:db": "vitest run db.test",
    "db:generate": "drizzle-kit generate",
    "db:up": "docker compose up -d --wait && supabase db push --db-url postgresql://postgres:postgres@127.0.0.1:54322/postgres --yes"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
