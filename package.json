{
  "name": "agent-world",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck": "wrangler types worker/worker-configuration.d.ts --check && tsc -p . && tsc -p web && tsc -p worker",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "verify": "pnpm typecheck && pnpm lint"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.45",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  }
}
